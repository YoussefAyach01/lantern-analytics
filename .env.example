# Port the HTTP server listens on.
PORT=4100

# Required. Bearer token for the /admin/* API (issue/list/revoke API keys that
# own sites). Must be at least 16 characters. Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-value

# Where the SQLite database file lives.
DB_PATH=./data/lantern.db

# Base URL this instance is reachable at (used in the embed snippet shown on the dashboard).
PUBLIC_URL=http://localhost:4100

# Set to "1" only when running behind a reverse proxy you control, so that
# X-Forwarded-For is trusted for the (never-persisted) dedup hash input. Leave "0" otherwise.
TRUST_PROXY=0
